<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.HuangApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rosso_salmone</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/rosso_salmone</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/white</item>
        <item name="colorOnSecondaryContainer">@color/rosso_salmone</item>
        <item name="android:windowBackground">@color/background_color</item>
    </style>
    <style name="Theme.HuangApp" parent="Base.Theme.HuangApp" />

    <style name="Widget.HuangApp.Button.Rounded" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/rosso_salmone</item>
        <item name="cornerRadius">100dp</item>
    </style>

</resources>


