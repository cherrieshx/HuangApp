<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.NewRecipeFragment">

    <data>
        <import type="android.view.View" />
        <variable
            name="newRecipeVM"
            type="it.progmob.huangapp.viewmodel.NewRecipeViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/recipe_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="1dp"
            android:paddingBottom="50dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp">

                <ImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:scaleType="centerCrop"
                    android:background="#F0F0F0"
                    app:imageUrl="@{newRecipeVM.image}"
                    tools:src="@drawable/ic_newimage" />
                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="@{newRecipeVM.isLoading ? View.VISIBLE : View.GONE}" />

                <ImageButton
                    android:id="@+id/btn_edit_image"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="16dp"
                    android:elevation="4dp"
                    android:src="@drawable/outline_edit_24"
                    app:tint="@color/rosso_salmone"
                    android:contentDescription="Modifica immagine"/>
            </FrameLayout>

            <EditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:layout_margin="10dp"
                android:text="@={newRecipeVM.name}"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/black"
                android:hint="Nome della ricetta"/>

            <EditText
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:layout_margin="10dp"
                android:text="@={newRecipeVM.description}"
                android:textSize="18sp"
                android:layout_marginTop="20dp"
                android:hint="Descrizione della ricetta"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="12dp"
                    android:text="Ingredienti"
                    android:textSize="22sp"
                    android:textStyle="bold"/>
                <ImageButton
                    android:id="@+id/btn_add_ingredient"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/add"
                    app:tint="@color/rosso_salmone"
                    android:contentDescription="Aggiungi ingrediente"/>
            </LinearLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/row_item"
                android:layout_margin="5dp"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="12dp"
                    android:text="Passaggi"
                    android:textSize="22sp"
                    android:textStyle="bold"/>
                <ImageButton
                    android:id="@+id/btn_add_step"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/add"
                    app:tint="@color/rosso_salmone"
                    android:contentDescription="Aggiungi passaggio"/>
            </LinearLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/row_item"
                android:layout_margin="5dp"/>


            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@{newRecipeVM.errorMsg}"
                android:textColor="@color/rosso"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="@{newRecipeVM.errorMsg.empty ? View.GONE : View.VISIBLE}"
                tools:text="Nome obbligatorio" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:text="Condividi ricetta"
                android:textSize="20sp"
                />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
